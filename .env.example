# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=wrc_pipeline
MONGO_LANDING_COLLECTION=raw_documents
MONGO_PROCESSED_COLLECTION=processed_documents

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_LANDING_BUCKET=wrc-landing
MINIO_PROCESSED_BUCKET=wrc-processed
MINIO_LANDING_PREFIX=landing
MINIO_PROCESSED_PREFIX=processed

# Scrapy
SCRAPE_PARTITION_MONTHS=1
SCRAPE_CONCURRENT_REQUESTS=4
SCRAPE_DOWNLOAD_DELAY=0.5
SCRAPE_RETRY_TIMES=3
SCRAPE_DOWNLOAD_TIMEOUT=60
SCRAPE_REFRESH_EXISTING=false
SCRAPE_AUTOTHROTTLE_START_DELAY=1.0
SCRAPE_AUTOTHROTTLE_MAX_DELAY=60.0
SCRAPE_AUTOTHROTTLE_TARGET_CONCURRENCY=1.0
WRC_SEARCH_URL=https://www.workplacerelations.ie/en/search/?advance=true
WRC_USER_AGENT=kedra-wrc-assessment/1.0
WRC_ROBOTSTXT_OBEY=true
